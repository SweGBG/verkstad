# Kopiera till .env.local och fyll i. Lägg samma variabler i Vercel → Settings → Environment Variables.
# Utan nycklar körs sajten i demoläge (bokning/kontakt visar "demoläge", inloggning via demokonton).

# Supabase (inloggning, Mina sidor, admin)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Valfri — gör att bokningar sparas även om RLS stoppar anonyma inserts. ALDRIG NEXT_PUBLIC!
SUPABASE_SERVICE_ROLE_KEY=

# Resend (bokningsmejl + kontaktformulär)
RESEND_API_KEY=
# Avsändare — måste vara en verifierad domän i Resend för att kunden ska få sin bekräftelse
RESEND_FROM="IronDäck <boka@irondack.se>"
# Vem som får nya bokningar och meddelanden
OWNER_EMAIL=lenn.soder@protonmail.com
